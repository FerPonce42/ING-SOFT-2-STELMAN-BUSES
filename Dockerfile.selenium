# Contenedor para las pruebas funcionales (Selenium + Chromium headless). Issue #62.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STELMAN_HEADLESS=1 \
    CHROME_BIN=/usr/bin/chromium

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium chromium-driver \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY pytest.ini ./
COPY tests ./tests
COPY probar_funcionales.sh ./
RUN sed -i 's/\r$//' probar_funcionales.sh

CMD ["sh", "probar_funcionales.sh"]
